{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": false,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "bracketSpacing": false,
    "bracketSameLine": true,
    "htmlWhitespaceSensitivity": "strict",
    "sortImports": {
        "ignoreCase": false,
        "order": "asc",
        "newlinesBetween": true
    }
}